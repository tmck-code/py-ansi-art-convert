{
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        // run `ruff format` on save
        "editor.formatOnSave": true,
        // run `ruff fix` on save, and organize imports
        "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
        },
    },
    // set python & ruff paths to the repo virtual environment
    "python.defaultInterpreterPath":    "${workspaceFolder}/.venv/bin/python3",
    // use/prefer ruff configuration from pyproject.toml
    "ruff.interpreter":                 ["${workspaceFolder}/.venv/bin/python3"],
    "ruff.configuration":               "${workspaceFolder}/pyproject.toml",
    "ruff.configurationPreference":     "filesystemFirst",
    // enable mypy to actually run
    "mypy-type-checker.path":           ["${workspaceFolder}/.venv/bin/mypy"],
    "mypy-type-checker.interpreter":    ["${workspaceFolder}/.venv/bin/python3"],
    "mypy-type-checker.importStrategy": "fromEnvironment",
    // configure testing with pytest
    "python.testing.pytestArgs":        ["-vv", "./test"],
    "python.testing.pytestEnabled":     true,
    "python.testing.unittestEnabled":   false,
    "makefile.configureOnOpen":         false,
}