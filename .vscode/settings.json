{
    // python -----------------------------------
    "python.defaultInterpreterPath": ".venv/bin/python",       // use repo venv for python
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",       // use ruff to format on save
        "editor.formatOnSave": true,                           // run `ruff format` on save
        "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",                       // run `ruff fix` on save
            "source.organizeImports": "explicit"               // sort imports alphabetically
        },
    },
    "makefile.configureOnOpen":         false,
    // ruff -------------------------------------
    //
    "ruff.interpreter": [
        "${workspaceFolder}/.venv/bin/python3"                 // sometimes doesn't work without this
    ],
    "ruff.configuration": "${workspaceFolder}/pyproject.toml", // get ruff configuration from pyproject.toml
    "ruff.configurationPreference": "filesystemFirst",         // prefer/use the ruff rules in pyproject.toml
    "ruff.nativeServer": "on",                                 // better performance
    "ruff.format.preview": true,                               // enable preview/unstable features
    "ruff.lint.preview": true,                                 // enable preview/unstable features
    // mypy -------------------------------------
    //
    "mypy-type-checker.path": [
        "${workspaceFolder}/.venv/bin/mypy"                    // sometimes doesn't work without this
    ],
    "mypy-type-checker.importStrategy": "fromEnvironment",     // enable mypy to actually run
    "mypy-type-checker.cwd": "${workspaceFolder}",             // prefer using mypy from the repo venv
    "mypy-type-checker.interpreter": [                         // sometimes doesn't work without this
        "${workspaceFolder}/.venv/bin/python3"
    ],
    "mypy-type-checker.reportingScope": "workspace",           // run over all files in the workspace
    "mypy-type-checker.preferDaemon": true,                    // noticable speed increase
    // testing ----------------------------------
    //
    "python.testing.pytestArgs": ["-vv", "./test"],            // configure testing with pytest
    "python.testing.pytestEnabled": true,                      // enable pytest
    "python.testing.unittestEnabled": false,                   // disable unittest
    "explorer.excludeGitIgnore": true,                         // hide files in .gitignore from the explorer
}
